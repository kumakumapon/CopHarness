# --- Provider Selection (optional) ---
# Explicitly select a provider: copilot, openai, anthropic, gemini, lmstudio, lemonade
# When unset, auto-detects based on which API key is configured (see priority order in README)
COPILOT_PROVIDER=

# --- GitHub Copilot ---
# Required for GitHub Copilot provider
# Get a Personal Access Token with `read:user` and `copilot` scopes from:
#   https://github.com/settings/tokens
GITHUB_COPILOT_API_KEY=your_github_token_here

# Alternative BYOK keys for Copilot-compatible providers
# (These are treated as OpenAI-compatible keys)
COPILOT_PROVIDER_API_KEY=
COPILOT_API_KEY=

# --- OpenAI ---
# Required for OpenAI provider
# Get an API key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
# Optional: specify a custom model (e.g., gpt-4o, gpt-4-turbo)
# When unset, falls back to COPILOT_MODEL
OPENAI_MODEL=

# --- Anthropic ---
# Required for Anthropic provider
# Get an API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: specify a custom model (e.g., claude-3-opus, claude-3-sonnet)
# When unset, falls back to COPILOT_MODEL
ANTHROPIC_MODEL=

# --- Google Gemini ---
# Required for Gemini provider
# Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: specify a custom model (e.g., gemini-2.0-flash, gemini-1.5-pro)
# Default: gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-pro
# Optional: override the Gemini endpoint URL
GEMINI_ENDPOINT=
# Request timeout in milliseconds (default: 10000)
GEMINI_TIMEOUT_MS=10000
# Maximum number of retries on transient errors (default: 3)
GEMINI_RETRY_MAX=3

# --- LM Studio (local LLM provider) ---
# Use local models via LM Studio
# Set COPILOT_PROVIDER=lmstudio or set LMSTUDIO_BASE_URL to auto-detect
# Download models at https://lmstudio.ai/
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Optional: specify a model name (leave empty to use whichever model is currently loaded)
LMSTUDIO_MODEL=

# --- Lemonade Server (local LLM for AMD GPUs/NPUs) ---
# Use AMD Lemonade Server for local LLM inference (no API key required)
# Set COPILOT_PROVIDER=lemonade or set LEMONADE_BASE_URL to auto-detect
# Get Lemonade Server at https://github.com/amd/lemonade
LEMONADE_BASE_URL=http://localhost:8000/api/v0
# Model name to request
LEMONADE_MODEL=

# --- Discord Bot ---
# Required to run the Discord bot (npm run discord)
# Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Optional: maximum number of user/assistant message pairs to keep per channel (default: 20)
DISCORD_MAX_HISTORY=20

# --- LINE Bot ---
# Required to enable the LINE Bot webhook (POST /api/line)
# Create a Messaging API channel at https://developers.line.biz/console/
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Optional: maximum number of user/assistant message pairs to keep per LINE user (default: 20)
LINE_MAX_HISTORY=20

# --- Conversation History Persistence ---
# Base directory for all persistent data files (conversation history, schedules,
# execution logs, transcripts).  When unset, defaults to the current working
# directory (legacy behaviour).
# Example: DATA_DIR=./data
DATA_DIR=

# Path to the JSON file where conversation histories (Discord/LINE) are persisted across restarts.
# When set, this takes precedence over DATA_DIR for this specific file.
# Default: <DATA_DIR>/conversation_history.json  (or ./conversation_history.json when DATA_DIR is unset)
CONVERSATION_HISTORY_FILE=

# --- Token budget for conversation history ---
# Maximum estimated tokens to keep in non-system conversation history per session.
# Older messages are dropped first when the budget is exceeded.
# This controls token consumption more accurately than message count alone.
# Default: 4000
HISTORY_TOKEN_BUDGET=4000

# Maximum estimated tokens allowed per individual message before it is truncated.
# Prevents a single long response (e.g. a large code block) from consuming the
# entire token budget.  Truncated messages are annotated with "…[省略]".
# Default: 800
HISTORY_MAX_MESSAGE_TOKENS=800

# --- Transcript logging ---
# Set to "true" to append per-session JSONL transcript files under
# <DATA_DIR>/transcripts/<YYYY-MM-DD>/<sessionKey>.jsonl
# Each line records a prompt, response, or error event with an ISO timestamp.
# Default: false (disabled)
TRANSCRIPT_LOGGING=false

# --- LLM Settings (applied to all providers unless overridden) ---
# Global model name (used when OPENAI_MODEL, ANTHROPIC_MODEL, etc. are not set)
# Default: gpt-5-mini (interpreted by each provider's adapter)
COPILOT_MODEL=gpt-5-mini
# LLM request timeout in milliseconds (default: 120000)
COPILOT_TIMEOUT_MS=120000
# Optional system prompt sent to the LLM in every conversation (used by CLI, Discord, LINE, HTTP API)
COPILOT_SYSTEM_PROMPT=

# --- Skills (tool calling) ---
# Comma-separated list of skill names to enable. When unset, all registered skills are available.
# Example: ENABLED_SKILLS=currentDateTime,calculator,getWeather
ENABLED_SKILLS=

# --- File skills (readFile, writeFile, listDirectory, searchInFiles) ---
# Sandbox directory for file operations (default: ./workspace)
SKILL_FILE_SANDBOX_DIR=./workspace

# --- Memory skill (memorySet, memoryGet, memoryList) ---
# Path to the persistent memory JSON file (default: ./memory.json)
SKILL_MEMORY_FILE=./memory.json

# --- Web search skill (webSearch) ---
# Tavily Search API key — sign up free at https://tavily.com
TAVILY_API_KEY=

# --- Translation skill (translateText) ---
# DeepL API key — sign up free at https://www.deepl.com/pro-api
# Free tier keys end with ":fx"
DEEPL_API_KEY=

# --- GitHub search skill (githubSearch) ---
# Personal Access Token for GitHub API (optional, increases rate limit)
# Falls back to GITHUB_COPILOT_API_KEY if set
GITHUB_TOKEN=

# --- Notification skill (sendNotification) ---
# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=
# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# --- getEnvVariable skill ---
# Comma-separated list of env var names the LLM is allowed to read.
# Defaults to a safe set: NODE_ENV, COPILOT_PROVIDER, COPILOT_MODEL, TZ, LANG, HOME, USER, SHELL, PATH
EXPOSED_ENV_VARS=

# --- Scheduled news delivery (newsBrief / techNews / trendSearch skills) ---
# To receive a daily news digest via the scheduler, create a scheduled prompt
# (via the dashboard or API) with a cron such as "0 9 * * *" (every day at 09:00).
#
# Example prompt:
#   "Fetch a news brief for topics ai, tech, and japan with 3 items per topic
#    using the newsBrief skill and summarise the results."
#
# Optionally, set a Discord channel ID on the schedule to have the result posted
# automatically. No additional environment variables are required for this feature.
