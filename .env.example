# CopHarness — secrets and quick overrides.
# Copy to .env.local. Structured settings (permissions, MCP, hooks, ...) live in copharness.json.

# --- Model ------------------------------------------------------------------
# "provider/model". When unset, the first provider with a key is used:
# ANTHROPIC_API_KEY → anthropic/claude-opus-5-5, OPENAI_API_KEY → openai/gpt-5-mini,
# GEMINI_API_KEY → gemini/gemini-2.5-flash, otherwise copilot/gpt-5-mini.
# Local servers: lmstudio/<model>, ollama/<model>, lemonade/<model>
COPHARNESS_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible endpoint for the "openai" provider (optional)
OPENAI_BASE_URL=
GEMINI_API_KEY=
# openrouter/<model> and github/<model> (GitHub Models) use these
OPENROUTER_API_KEY=
GITHUB_TOKEN=
# Alternative endpoints for proxies/gateways (optional). The Anthropic SDK sends
# the key as "Authorization: Bearer", so a gateway must accept that header.
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
# Local server URLs (defaults shown)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LEMONADE_BASE_URL=http://localhost:8000/api/v0
# GitHub Copilot (copilot/<model>): `copilot login`, or COPILOT_GITHUB_TOKEN / GH_TOKEN

# --- Behaviour (optional; copharness.json is the main place) ------------------
# default | acceptEdits | readonly | bypass
COPHARNESS_PERMISSION_MODE=
# Directory the file tools and bash work in (default ./workspace)
COPHARNESS_WORKSPACE=
# Sessions, memory, schedules, usage (default ./data)
COPHARNESS_DATA_DIR=
# Extra instructions appended to the system prompt
COPHARNESS_SYSTEM_PROMPT=
# low | medium | high | xhigh | max (Anthropic models that support effort)
COPHARNESS_EFFORT=
# Daily limits (USD / tokens); unset = unlimited
COPHARNESS_DAILY_COST_USD=
COPHARNESS_DAILY_TOKENS=

# --- HTTP API / web UI --------------------------------------------------------
# The API always requires a bearer token. When unset, one is generated in
# <data dir>/access-token and printed at startup (npm run cli -- token).
COPHARNESS_API_KEY=
# Behind a reverse proxy: how X-Forwarded-For is trusted for rate limiting
TRUSTED_PROXY_COUNT=
TRUSTED_PROXY_IPS=

# --- Chat channels (each is optional) ----------------------------------------
# Discord: the bot connects when the server starts (npm run dev / npm start)
DISCORD_BOT_TOKEN=
# LINE: webhook URL https://<host>/api/line
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Slack: Events API request URL https://<host>/api/slack
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- web_fetch network policy --------------------------------------------------
# Private / loopback addresses are blocked. Allow specific hosts if needed:
SKILL_HTTP_ALLOWED_HOSTS=
SKILL_HTTP_ALLOW_PRIVATE_NETWORKS=false
