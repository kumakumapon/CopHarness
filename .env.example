# GitHub Copilot API key (required for Copilot provider)
# Copy this file to .env.local and fill in your token.
# Get a Personal Access Token with Copilot scope from:
#   https://github.com/settings/tokens
GITHUB_COPILOT_API_KEY=your_github_token_here

# --- Google Gemini (optional) ---
# Set GEMINI_API_KEY to enable Gemini as the default provider.
# Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name (default: gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-pro
# Override the Gemini endpoint (optional)
GEMINI_ENDPOINT=
# Request timeout in milliseconds (default: 10000)
GEMINI_TIMEOUT_MS=10000
# Maximum number of retries on transient errors (default: 3)
GEMINI_RETRY_MAX=3

# --- Discord Bot ---
# Required to run the Discord bot (npm run discord)
# Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Optional: maximum number of user/assistant message pairs to keep per channel (default: 20)
DISCORD_MAX_HISTORY=20

# --- LINE Bot ---
# Required to enable the LINE Bot webhook (POST /api/line)
# Create a Messaging API channel at https://developers.line.biz/console/
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Optional: maximum number of user/assistant message pairs to keep per LINE user (default: 20)
LINE_MAX_HISTORY=20

# --- LLM settings (shared by CLI and Discord bot) ---
# Override the model (provider-specific default is used when unset)
COPILOT_MODEL=gpt-5-mini
# LLM request timeout in milliseconds (default: 120000)
COPILOT_TIMEOUT_MS=120000
# Optional system prompt sent to the LLM in every conversation
COPILOT_SYSTEM_PROMPT=

# --- Skills (tool calling) ---
# Comma-separated list of skill names to enable. When unset, all registered skills are available.
# Example: ENABLED_SKILLS=currentDateTime,calculator,getWeather
ENABLED_SKILLS=

# --- File skills (readFile, writeFile, listDirectory, searchInFiles) ---
# Sandbox directory for file operations (default: ./workspace)
SKILL_FILE_SANDBOX_DIR=./workspace

# --- Memory skill (memorySet, memoryGet, memoryList) ---
# Path to the persistent memory JSON file (default: ./memory.json)
SKILL_MEMORY_FILE=./memory.json

# --- Web search skill (webSearch) ---
# Tavily Search API key — sign up free at https://tavily.com
TAVILY_API_KEY=

# --- Translation skill (translateText) ---
# DeepL API key — sign up free at https://www.deepl.com/pro-api
# Free tier keys end with ":fx"
DEEPL_API_KEY=

# --- GitHub search skill (githubSearch) ---
# Personal Access Token for GitHub API (optional, increases rate limit)
# Falls back to GITHUB_COPILOT_API_KEY if set
GITHUB_TOKEN=

# --- Notification skill (sendNotification) ---
# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=
# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# --- getEnvVariable skill ---
# Comma-separated list of env var names the LLM is allowed to read.
# Defaults to a safe set: NODE_ENV, COPILOT_PROVIDER, COPILOT_MODEL, TZ, LANG, HOME, USER, SHELL, PATH
EXPOSED_ENV_VARS=
# Set COPILOT_PROVIDER=lmstudio to use LM Studio, or set LMSTUDIO_BASE_URL to auto-detect.
# LM Studio must be running and have a model loaded.
# Default endpoint: http://localhost:1234/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Model name to request (leave empty to use whichever model is loaded in LM Studio)
LMSTUDIO_MODEL=

# --- Lemonade Server (local LLM for AMD GPUs/NPUs, no API key required) ---
# Set COPILOT_PROVIDER=lemonade to use Lemonade Server, or set LEMONADE_BASE_URL to auto-detect.
# Default endpoint: http://localhost:8000/api/v0
LEMONADE_BASE_URL=http://localhost:8000/api/v0
# Model name to request
LEMONADE_MODEL=
